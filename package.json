{
  "name": "jl-skills-installer",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test:installer": "bun test --timeout 20000 tests",
    "smoke": "cargo test --release --manifest-path skills/map/Cargo.toml --target-dir build/cargo/map && bun run build && bun run test:installer"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "adm-zip": "0.6.0"
  }
}
